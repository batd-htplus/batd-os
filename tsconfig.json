{
    "compilerOptions": {
        "target": "esnext",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "types": ["node"],
        "strict": true,
        "noEmit": true,
        "erasableSyntaxOnly": true,
        "verbatimModuleSyntax": true,
        "allowImportingTsExtensions": true,
        "rewriteRelativeImportExtensions": false,
        "skipLibCheck": true,
        "noUnusedLocals": true
    },
    "include": ["src", "tests"],
    "exclude": ["ecc", "cloudflare-os", "node_modules", ".flow"]
}
